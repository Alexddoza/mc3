 #import <AVFoundation/AVFoundation.h>
 #include <string>
+#include "UI/SingleGame.h"
+#if defined(PPSSPP_SINGLE_GAME)
+#import <CommonCrypto/CommonDigest.h>
+
+// Fast launch preflight: all file sizes, plus hashes for the boot/SFO/UMD files.
+// Full SHA-256 verification of every asset is performed by the packaging tool.
+static NSString *CheckSingleGameContent(NSString *root) {
+	NSFileManager *fm = [NSFileManager defaultManager];
+	NSString *manifestPath = [[root stringByDeletingLastPathComponent] stringByAppendingPathComponent:@"manifest.json"];
+	NSData *data = [NSData dataWithContentsOfFile:manifestPath];
+	if (!data) return @"The private game manifest is missing. Rebuild the app with your game-root folder.";
+	id object = [NSJSONSerialization JSONObjectWithData:data options:0 error:nil];
+	if (![object isKindOfClass:[NSDictionary class]]) return @"The private game manifest is invalid.";
+	NSDictionary *manifest = object;
+	if (![manifest[@"disc_id"] isEqual:@"ULUS10021"] || ![manifest[@"files"] isKindOfClass:[NSArray class]])
+		return @"The bundled content is not the configured Midnight Club 3 edition (ULUS10021).";
+	NSArray *required = @[@"PSP_GAME/PARAM.SFO", @"PSP_GAME/SYSDIR/EBOOT.BIN", @"PSP_GAME/USRDIR/pspasset.dat", @"UMD_DATA.BIN"];
+	NSMutableSet *seen = [NSMutableSet set];
+	for (id item in manifest[@"files"]) {
+		if (![item isKindOfClass:[NSDictionary class]]) return @"The game manifest has an invalid entry.";
+		NSString *relative = item[@"path"];
+		if (![relative isKindOfClass:[NSString class]] || [relative isAbsolutePath] ||
+			[[relative pathComponents] containsObject:@".."] || [seen containsObject:relative])
+			return @"The game manifest contains an invalid path.";
+		[seen addObject:relative];
+		NSString *file = [root stringByAppendingPathComponent:relative];
+		NSDictionary *attributes = [fm attributesOfItemAtPath:file error:nil];
+		NSNumber *expectedSize = item[@"size"];
+		if (![expectedSize isKindOfClass:[NSNumber class]] ||
+			![attributes[NSFileType] isEqual:NSFileTypeRegular] ||
+			[attributes[NSFileSize] unsignedLongLongValue] != [expectedSize unsignedLongLongValue])
+			return [NSString stringWithFormat:@"Missing or incomplete game file: %@. Rebuild from a verified copy.", relative];
+		BOOL critical = [relative isEqual:@"PSP_GAME/PARAM.SFO"] ||
+			[relative hasPrefix:@"PSP_GAME/SYSDIR/"] || [relative isEqual:@"UMD_DATA.BIN"];
+		if (critical) {
+			// Cap files read into memory. The configured edition's boot files are small.
+			if ([expectedSize unsignedLongLongValue] > 32 * 1024 * 1024)
+				return @"A boot file is unexpectedly large.";
+			NSData *bytes = [NSData dataWithContentsOfFile:file];
+			if (!bytes) return [NSString stringWithFormat:@"Cannot read boot file: %@", relative];
+			unsigned char digest[CC_SHA256_DIGEST_LENGTH];
+			CC_SHA256(bytes.bytes, (CC_LONG)bytes.length, digest);
+			NSMutableString *hex = [NSMutableString stringWithCapacity:64];
+			for (unsigned char byte : digest) [hex appendFormat:@"%02x", byte];
+			if (![hex isEqual:item[@"sha256"]])
+				return [NSString stringWithFormat:@"Corrupt boot file: %@. Rebuild from a verified copy.", relative];
+		}
+	}
+	for (NSString *path in required) {
+		if (![seen containsObject:path]) return [NSString stringWithFormat:@"Required game file is not listed: %@", path];
+	}
+	return nil;
+}
+#endif
 
